#: config/settings.py:146
msgid "Castellano"
msgstr "Castellà"

#: config/settings.py:147
msgid "Catala"
msgstr "Català"

#: routes/views.py:217
#, python-format
msgid "Debe estar entre 0 y %(max)d."
msgstr "Ha d'estar entre 0 i %(max)d."

#: routes/views.py:129
msgid "Debe ser un id de usuario o \"me\"."
msgstr "Ha de ser un id d'usuari o \"me\"."

#: users/views.py:248
msgid "Debe ser un id de usuario."
msgstr "Ha de ser un id d'usuari."

#: routes/views.py:212
msgid "Debe ser un numero."
msgstr "Ha de ser un número."

#: authentication/views.py:57
msgid "El token de Firebase no trae email."
msgstr "El token de Firebase no porta correu electrònic."

#: authentication/views.py:53
msgid "El token de Firebase no trae uid."
msgstr "El token de Firebase no porta uid."

#: authentication/serializers.py:46
msgid "Email o contrasena incorrectos."
msgstr "Correu electrònic o contrasenya incorrectes."

#: config/settings.py:148
msgid "English"
msgstr "Anglès"

#: routes/views.py:184
msgid "Formato esperado: near=latitud,longitud."
msgstr "Format esperat: near=latitud,longitud."

#: routes/serializers.py:125
msgid "Hay puntos con el mismo \"order\"."
msgstr "Hi ha punts amb el mateix \"order\"."

#: routes/serializers.py:152
#, python-format
msgid "La duracion debe estar entre %(min)d y %(max)d minutos."
msgstr "La durada ha d'estar entre %(min)d i %(max)d minuts."

#: routes/views.py:198
msgid "Latitud entre -90 y 90, longitud entre -180 y 180."
msgstr "Latitud entre -90 i 90, longitud entre -180 i 180."

#: routes/views.py:192
msgid "Latitud y longitud deben ser numeros."
msgstr "La latitud i la longitud han de ser números."

#: routes/permissions.py:13
msgid "No eres el autor de esta ruta."
msgstr "No ets l'autor d'aquesta ruta."

#: users/serializers.py:270
msgid "No puedes enviarte una solicitud a ti mismo."
msgstr "No et pots enviar una sol·licitud a tu mateix."

#: authentication/views.py:164
msgid "Sesion cerrada."
msgstr "Sessió tancada."

#: authentication/views.py:193
msgid "Si existe una cuenta con ese email, recibiras un correo con instrucciones."
msgstr "Si existeix un compte amb aquest correu electrònic, rebràs un correu amb instruccions."

#: authentication/views.py:46
msgid "Token de Firebase invalido."
msgstr "El token de Firebase no és vàlid."

#: routes/serializers.py:116
#, python-format
msgid "Una ruta admite como mucho %(count)d puntos."
msgstr "Una ruta admet com a màxim %(count)d punts."

#: routes/serializers.py:110
#, python-format
msgid "Una ruta necesita al menos %(count)d puntos."
msgstr "Una ruta necessita com a mínim %(count)d punts."

#: routes/views.py:93
#: routes/views.py:147
#: users/views.py:146
#, python-format
msgid "Valores validos: %(values)s."
msgstr "Valors vàlids: %(values)s."

#: users/serializers.py:230
msgid "Ya existe un usuario con este nombre."
msgstr "Ja existeix un usuari amb aquest nom."

#: authentication/serializers.py:67
msgid "Ya existe una cuenta con este email."
msgstr "Ja existeix un compte amb aquest correu electrònic."
